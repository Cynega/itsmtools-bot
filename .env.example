# Para desarrollo local: copiá este archivo como .env.local (lo lee `vercel dev`).
# Para producción: cargá estas vars en Vercel Dashboard → Project → Settings → Environment Variables.
# NUNCA commitear .env / .env.local a git.

DATAFORSEO_LOGIN=tu_email@ejemplo.com
DATAFORSEO_PASSWORD=tu_password_dataforseo

WP_URL=https://itsmtools.com
WP_USER=tu_usuario_wordpress
WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

ANTHROPIC_API_KEY=sk-ant-...

# Auth
APP_PASSWORD=elegi_un_password_largo
# Random hex de 64+ chars. Generar con: openssl rand -hex 32
AUTH_SECRET=cambia_esto_por_64_caracteres_hex_aleatorios
